# URL completa del evento de agenda.
# Todos los botones y el embed se derivan de esta variable.
PUBLIC_CAL_URL=https://cal.com/tuusuario/auditoria

# Endpoint del formulario de contacto.
# En producción lo sirve el Worker del sitio en /api/contacto (mismo origen).
# Para probar el formulario en local hace falta `wrangler dev` o apuntar a un
# webhook externo; `astro dev` no ejecuta el Worker.
PUBLIC_FORM_ENDPOINT=/api/contacto
