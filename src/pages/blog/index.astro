---
import BlogCard from '../../components/BlogCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/categories';
import { getPublishedPosts } from '../../lib/content';

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
---

<BaseLayout
  title="Blog de automatización e IA aplicada | Orinoco AI Solutions"
  description="Artículos sobre automatización de procesos, agentes de IA e integraciones entre herramientas. Ideas prácticas para decidir mejor y ordenar tu operación."
  keywords={['blog automatización', 'IA aplicada', 'integrar herramientas', 'procesos de negocio']}
>
  <PageHero
    eyebrow="Blog"
    title="Ideas para una operación más simple."
    description="Artículos sobre automatización, IA aplicada e integraciones, escritos para decidir mejor, no para repetir titulares."
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Blog' }]}
  >
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="/rss.xml"
        class="inline-flex items-center gap-2 rounded-full border border-cyan/40 px-4 py-2 text-sm text-ink transition-colors hover:border-cyan hover:bg-cyan/5"
      >
        <svg class="h-4 w-4 text-cyan" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="5" cy="15" r="1.5" fill="currentColor" />
          <path d="M4 10a6 6 0 0 1 6 6M4 5a11 11 0 0 1 11 11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
        Suscribirse por RSS
      </a>
      <span class="text-xs text-muted">{posts.length} artículos publicados</span>
    </div>
  </PageHero>

  <section class="container-page py-12 md:py-16">
    <nav aria-label="Categorías del blog" class="flex flex-wrap gap-2">
      {
        categories.map((category) => (
          <a
            href={`/blog/categoria/${category.slug}/`}
            class="rounded-full border border-river/30 bg-surface/40 px-4 py-2 text-sm text-muted transition-colors hover:border-cyan/50 hover:text-ink"
          >
            {category.name}
          </a>
        ))
      }
    </nav>

    {
      featured ? (
        <div class="mt-10">
          <p class="eyebrow">Último artículo</p>
          <div class="mt-5">
            <BlogCard post={featured} featured headingLevel={2} />
          </div>
        </div>
      ) : (
        <div class="mt-10 rounded-2xl border border-river/25 bg-surface/40 p-8 text-center">
          <p class="font-display text-xl font-semibold text-ink">Todavía no hay artículos publicados.</p>
          <p class="mt-3 text-sm text-muted">Estamos preparando el primero. Mientras tanto, puedes revisar los servicios.</p>
          <a href="/servicios/" class="link-inline mt-4 inline-block text-sm">Ver servicios</a>
        </div>
      )
    }

    {
      rest.length > 0 && (
        <div class="mt-14">
          <div class="flex items-center justify-between gap-4 border-t border-white/5 pt-8">
            <h2 class="font-display text-xl font-semibold text-ink">Más artículos</h2>
            <span class="text-xs text-muted">{rest.length} {rest.length === 1 ? 'artículo' : 'artículos'}</span>
          </div>
          <div class="mt-6 grid gap-5 md:grid-cols-2">
            {rest.map((post) => <BlogCard post={post} />)}
          </div>
        </div>
      )
    }
  </section>

  <CtaBanner
    eyebrow="Más allá del artículo"
    title="¿Tienes un proceso que quieres ordenar?"
    text="Cuéntanos qué está frenando tu operación. En una conversación corta vemos si la automatización, un agente o una integración tiene sentido para tu caso."
  />
</BaseLayout>
