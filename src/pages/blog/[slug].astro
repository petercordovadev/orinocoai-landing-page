---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BlogCard from '../../components/BlogCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categorySlug } from '../../data/categories';
import { site } from '../../data/site';
import { getPublishedPosts, getRelatedPosts, type BlogPost } from '../../lib/content';
import { formatDate, readingTime } from '../../lib/format';
import { articleSchema } from '../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = await getRelatedPosts(post, 2);
const postUrl = `/blog/${post.id}/`;
const categoryUrl = `/blog/categoria/${categorySlug(post.data.category)}/`;

const jsonLd = articleSchema({
  title: post.data.title,
  description: post.data.description,
  url: postUrl,
  image: post.data.image.src,
  datePublished: post.data.date,
  dateModified: post.data.updatedDate,
  category: post.data.category,
  keyword: post.data.keyword,
});
---

<BaseLayout
  title={`${post.data.title} | Orinoco AI Solutions`}
  description={post.data.description}
  image={post.data.image.src}
  imageAlt={post.data.imageAlt ?? post.data.title}
  imageWidth={post.data.image.width}
  imageHeight={post.data.image.height}
  type="article"
  keywords={[post.data.keyword, post.data.category]}
  jsonLd={jsonLd}
  publishedTime={post.data.date}
  modifiedTime={post.data.updatedDate}
  articleSection={post.data.category}
>
  <article>
    <header class="border-b border-white/5">
      <div class="container-page pb-10 pt-10 md:pb-14 md:pt-14">
        <Breadcrumbs
          items={[
            { label: 'Inicio', href: '/' },
            { label: 'Blog', href: '/blog/' },
            { label: post.data.title },
          ]}
        />

        <div class="mt-10 max-w-4xl">
          <a
            href={categoryUrl}
            class="inline-flex rounded-full border border-cyan/30 bg-cyan/5 px-3 py-1 font-display text-[0.7rem] uppercase tracking-[0.16em] text-cyan transition-colors hover:border-cyan/60"
          >
            {post.data.category}
          </a>
          <h1 class="mt-5 text-4xl font-semibold leading-[1.06] text-ink sm:text-5xl md:text-6xl">
            {post.data.title}
          </h1>
          <p class="mt-5 max-w-2xl text-base leading-7 text-muted md:text-lg">
            {post.data.description}
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-muted">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            {
              post.data.updatedDate && (
                <>
                  <span aria-hidden="true" class="text-river">·</span>
                  <span>Actualizado el {formatDate(post.data.updatedDate)}</span>
                </>
              )
            }
            <span aria-hidden="true" class="text-river">·</span>
            <span>{readingTime(post.body ?? '')} min de lectura</span>
            <span aria-hidden="true" class="text-river">·</span>
            <span>Por {site.founder}</span>
          </div>
        </div>

        <div class="mt-9 max-w-5xl overflow-hidden rounded-2xl border border-river/25 bg-surface">
          <Image
            src={post.data.image}
            alt={post.data.imageAlt ?? post.data.title}
            width={1200}
            height={630}
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="h-auto w-full object-cover"
          />
        </div>
      </div>
    </header>

    <div class="container-page py-12 md:py-16">
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
        <div class="prose prose-orinoco max-w-3xl prose-base md:prose-lg">
          <Content />
        </div>

        <aside class="lg:pt-1">
          <div class="space-y-5 lg:sticky lg:top-24">
            <div class="card p-6">
              <p class="font-display text-xs font-medium uppercase tracking-[0.16em] text-cyan">Autor</p>
              <div class="mt-4 flex items-center gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-full border border-river/40 bg-river/10 font-display text-sm font-semibold text-cyan">
                  PC
                </span>
                <div>
                  <p class="font-display text-sm font-semibold text-ink">{site.founder}</p>
                  <p class="text-xs text-muted">Fundador de Orinoco AI Solutions</p>
                </div>
              </div>
              <p class="mt-4 text-sm leading-6 text-muted">
                Fundador de Orinoco AI Solutions. Escribe sobre procesos, IA aplicada e integraciones.
              </p>
              <a href="/sobre-orinoco/" class="link-inline mt-4 inline-block text-sm">Conocer más</a>
            </div>

            <div class="card p-6">
              <p class="font-display text-xs font-medium uppercase tracking-[0.16em] text-cyan">Categoría</p>
              <a
                href={categoryUrl}
                class="mt-3 inline-flex text-sm font-medium text-ink transition-colors hover:text-cyan"
              >
                {post.data.category}
                <span aria-hidden="true" class="ml-1">→</span>
              </a>
              <p class="mt-3 text-sm leading-6 text-muted">
                Más artículos sobre {post.data.category.toLowerCase()} en el blog.
              </p>
              <a href="/blog/" class="link-inline mt-4 inline-block text-sm">Ver todos</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-y border-white/5 bg-surface/35">
        <div class="container-page py-16 md:py-20">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="eyebrow">Seguir leyendo</p>
              <h2 class="mt-4 text-2xl font-semibold text-ink md:text-3xl">Otros artículos que pueden servirte.</h2>
            </div>
            <a href="/blog/" class="text-sm font-medium text-cyan hover:underline">Ver todos los artículos</a>
          </div>
          <div class="mt-8 grid gap-5 md:grid-cols-2">
            {related.map((item) => <BlogCard post={item} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBanner
    eyebrow="Siguiente paso"
    title="¿Quieres revisar tu caso?"
    text="Cuéntanos qué proceso o tarea está frenando tu operación. En una llamada corta vemos si hay una forma razonable de mejorarlo."
  />
</BaseLayout>
