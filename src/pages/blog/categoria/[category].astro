---
import BlogCard from '../../../components/BlogCard.astro';
import CtaBanner from '../../../components/CtaBanner.astro';
import PageHero from '../../../components/PageHero.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categories, type Category } from '../../../data/categories';
import { getPublishedPosts } from '../../../lib/content';

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter((post) => post.data.category === category.name);
---

<BaseLayout
  title={`${category.name}: artículos y guías | Orinoco AI Solutions`}
  description={`Artículos sobre ${category.name.toLowerCase()}: guías prácticas para ordenar procesos, datos y herramientas en tu negocio.`}
  keywords={[category.name.toLowerCase(), 'blog', 'automatización', 'IA aplicada']}
>
  <PageHero
    eyebrow="Categoría"
    title={category.name}
    description={category.description}
    breadcrumbs={[
      { label: 'Inicio', href: '/' },
      { label: 'Blog', href: '/blog/' },
      { label: category.name },
    ]}
  >
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/blog/" class="rounded-full border border-river/30 bg-surface/40 px-4 py-2 text-sm text-muted transition-colors hover:border-cyan/50 hover:text-ink">
        Todos los artículos
      </a>
      {
        categories
          .filter((item) => item.slug !== category.slug)
          .map((item) => (
            <a
              href={`/blog/categoria/${item.slug}/`}
              class="rounded-full border border-river/30 bg-surface/40 px-4 py-2 text-sm text-muted transition-colors hover:border-cyan/50 hover:text-ink"
            >
              {item.name}
            </a>
          ))
      }
    </div>
  </PageHero>

  <section class="container-page py-12 md:py-16">
    {
      posts.length > 0 ? (
        <div class="grid gap-5 md:grid-cols-2">
          {posts.map((post) => <BlogCard post={post} headingLevel={2} />)}
        </div>
      ) : (
        <div class="rounded-2xl border border-river/25 bg-surface/40 p-8 text-center">
          <p class="font-display text-xl font-semibold text-ink">Todavía no hay artículos en esta categoría.</p>
          <p class="mt-3 text-sm text-muted">Estamos preparando contenido sobre {category.name.toLowerCase()}.</p>
          <a href="/blog/" class="link-inline mt-4 inline-block text-sm">Ver todos los artículos</a>
        </div>
      )
    }
  </section>

  <CtaBanner
    eyebrow="Siguiente paso"
    title="¿Quieres aplicar esto a tu negocio?"
    text="Revisamos tu caso y te decimos si tiene sentido automatizarlo, con qué enfoque y qué haría falta."
  />
</BaseLayout>
