---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { cal } from '../lib/cal';

const steps = [
  {
    title: 'Revisa tu correo',
    text: 'Si reservaste una llamada, recibirás la confirmación con la fecha, la hora y el enlace de acceso. Revisa también la carpeta de spam.',
  },
  {
    title: 'Prepara el contexto',
    text: 'No hace falta una presentación. Piensa en el proceso que más tiempo consume, las herramientas implicadas y qué te gustaría que ocurriera.',
  },
  {
    title: 'Nos vemos en la llamada',
    text: 'Revisaremos el caso y saldremos con una idea clara de si tiene sentido automatizarlo y por dónde empezar.',
  },
];
---

<BaseLayout
  title="Gracias por dar el paso | Orinoco AI Solutions"
  description="Tu solicitud o reserva fue recibida. Estos son los siguientes pasos para preparar la conversación."
  noindex
>
  <section class="container-page flex min-h-[70svh] flex-col items-center justify-center py-20 text-center md:py-28">
    <span class="flex h-16 w-16 items-center justify-center rounded-full border border-river/40 bg-river/10 text-cyan">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>

    <p class="eyebrow mt-8">Solicitud recibida</p>
    <h1 class="mt-5 max-w-3xl text-4xl font-semibold text-ink sm:text-5xl md:text-6xl">
      Gracias por dar el paso.
    </h1>
    <p class="mt-5 max-w-xl text-base leading-7 text-muted md:text-lg">
      Tu mensaje o tu reserva quedó registrada. Si reservaste una llamada, revisa el correo de confirmación;
      si enviaste el formulario, te responderé por la dirección que indicaste.
    </p>

    <div class="mt-10 grid w-full max-w-4xl gap-4 text-left sm:grid-cols-3">
      {
        steps.map((step, index) => (
          <article class="rounded-2xl border border-white/8 bg-surface/50 p-5">
            <span class="font-display text-xs font-medium tracking-[0.18em] text-amber">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h2 class="mt-4 font-display text-base font-semibold text-ink">{step.title}</h2>
            <p class="mt-2 text-sm leading-6 text-muted">{step.text}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button href="/servicios/" variant="secondary" size="lg">Mientras tanto, ver servicios</Button>
      <Button href="/blog/" variant="ghost" size="lg">Leer el blog</Button>
    </div>

    <p class="mt-8 max-w-md text-xs leading-6 text-muted/80">
      ¿No recibiste la confirmación? Escríbenos a
      <a href={`mailto:${site.email}`} class="link-inline">{site.email}</a>. Si necesitas reprogramar, puedes
      hacerlo desde <a href={cal.href} target="_blank" rel="noopener noreferrer" class="link-inline">la agenda</a>.
    </p>
  </section>
</BaseLayout>
