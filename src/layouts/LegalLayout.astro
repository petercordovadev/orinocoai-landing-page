---
import PageHero from '../components/PageHero.astro';
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  updated: string;
  breadcrumbs: Crumb[];
}

const { title, description, updated, breadcrumbs } = Astro.props;
---

<BaseLayout title={`${title} | ${site.name}`} description={description}>
  <PageHero eyebrow="Legal" title={title} description={description} breadcrumbs={breadcrumbs} />

  <section class="container-page py-14 md:py-20">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <article class="prose prose-orinoco max-w-3xl prose-base md:prose-lg">
        <slot />
      </article>

      <aside class="lg:pt-1">
        <div class="rounded-2xl border border-river/25 bg-surface/50 p-5 lg:sticky lg:top-24">
          <p class="font-display text-xs font-medium uppercase tracking-[0.16em] text-cyan">Documento legal</p>
          <p class="mt-3 text-sm leading-6 text-muted">
            Última actualización: <span class="text-ink">{updated}</span>
          </p>
          <p class="mt-4 text-sm leading-6 text-muted">
            ¿Tienes una duda sobre este documento? Escríbenos a
            <a href={`mailto:${site.email}`} class="link-inline break-all">{site.email}</a>.
          </p>
          <div class="mt-5 flex flex-col gap-2 border-t border-white/5 pt-4 text-sm">
            <a href="/privacidad/" class="text-ink/85 transition-colors hover:text-cyan">Política de privacidad</a>
            <a href="/terminos/" class="text-ink/85 transition-colors hover:text-cyan">Términos de uso</a>
            <a href="/contacto/" class="text-ink/85 transition-colors hover:text-cyan">Contacto</a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
