---
import { Image } from 'astro:assets';
import type { Service } from '../lib/content';

interface Props {
  service: Service;
  priority?: boolean;
  headingLevel?: 2 | 3;
}

const { service, priority = false, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
const href = `/servicios/${service.id}/`;
---

<article class="card card-interactive group flex h-full flex-col overflow-hidden">
  <a href={href} class="flex h-full flex-col" aria-label={`Ver servicio: ${service.data.title}`}>
    <div class="relative overflow-hidden border-b border-white/5">
      <Image
        src={service.data.image}
        alt={service.data.imageAlt}
        width={720}
        height={480}
        format="webp"
        loading={priority ? 'eager' : 'lazy'}
        class="h-48 w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
      <span class="absolute left-4 top-4 rounded-full border border-white/10 bg-night/80 px-3 py-1 font-display text-[0.65rem] uppercase tracking-[0.16em] text-cyan backdrop-blur">
        Servicio
      </span>
    </div>
    <div class="flex flex-1 flex-col p-6">
      <Heading class="font-display text-xl font-semibold text-ink transition-colors group-hover:text-cyan">
        {service.data.shortTitle}
      </Heading>
      <p class="mt-3 flex-1 text-sm leading-6 text-muted">{service.data.summary}</p>
      <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-cyan">
        Ver servicio
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>
  </a>
</article>
