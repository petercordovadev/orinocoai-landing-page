---
import { site } from '../data/site';
import { organizationSchema, websiteSchema } from '../lib/jsonld';
import JsonLd from './JsonLd.astro';

type JsonLdData = Record<string, unknown>;

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: JsonLdData | JsonLdData[];
  publishedTime?: Date;
  modifiedTime?: Date;
  articleSection?: string;
}

const {
  title,
  description,
  image = '/og-image.png',
  imageAlt = 'Orinoco AI Solutions: automatización e IA aplicada a negocios.',
  imageWidth = 1200,
  imageHeight = 630,
  type = 'website',
  noindex = false,
  keywords = [],
  jsonLd,
  publishedTime,
  modifiedTime,
  articleSection,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(site.url);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [organizationSchema(), websiteSchema(), ...pageSchemas];
const robots = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.founder} />
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />

{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="es_ES" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@petercordovadev" />
<meta name="twitter:creator" content="@petercordovadev" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{articleSection && <meta property="article:section" content={articleSection} />}

{schemas.map((schema) => <JsonLd data={schema} />)}
