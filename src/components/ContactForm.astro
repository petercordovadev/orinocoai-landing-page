---
import { PUBLIC_FORM_ENDPOINT } from 'astro:env/client';
import { site } from '../data/site';
---

<form
  id="contact-form"
  class="card p-6 md:p-8"
  data-machine="contact-form"
  data-state="idle"
  data-endpoint={PUBLIC_FORM_ENDPOINT}
  novalidate
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="name" class="mb-2 block text-sm font-medium text-ink">Nombre <span class="text-amber">*</span></label>
      <input
        id="name"
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby="error-name"
        class="w-full rounded-xl border border-river/30 bg-night/60 px-4 py-3 text-sm text-ink placeholder:text-muted/80 transition-colors focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20"
        placeholder="Tu nombre"
      />
      <p id="error-name" data-error-for="name" class="mt-2 hidden text-xs text-amber"></p>
    </div>

    <div>
      <label for="email" class="mb-2 block text-sm font-medium text-ink">Correo <span class="text-amber">*</span></label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        required
        aria-describedby="error-email"
        class="w-full rounded-xl border border-river/30 bg-night/60 px-4 py-3 text-sm text-ink placeholder:text-muted/80 transition-colors focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20"
        placeholder="tu@correo.com"
      />
      <p id="error-email" data-error-for="email" class="mt-2 hidden text-xs text-amber"></p>
    </div>
  </div>

  <div class="mt-5">
    <label for="company" class="mb-2 block text-sm font-medium text-ink">Empresa <span class="text-xs font-normal text-muted">(opcional)</span></label>
    <input
      id="company"
      name="company"
      type="text"
      autocomplete="organization"
      class="w-full rounded-xl border border-river/30 bg-night/60 px-4 py-3 text-sm text-ink placeholder:text-muted/80 transition-colors focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20"
      placeholder="Nombre de tu negocio"
    />
  </div>

  <div class="mt-5">
    <label for="message" class="mb-2 block text-sm font-medium text-ink">¿Qué quieres resolver? <span class="text-amber">*</span></label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      aria-describedby="error-message"
      class="w-full resize-y rounded-xl border border-river/30 bg-night/60 px-4 py-3 text-sm text-ink placeholder:text-muted/80 transition-colors focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/20"
      placeholder="Cuéntame brevemente qué proceso, herramienta o tarea te está consumiendo tiempo."
    ></textarea>
    <p id="error-message" data-error-for="message" class="mt-2 hidden text-xs text-amber"></p>
  </div>

  <div class="mt-6 flex items-start gap-3">
    <input
      id="privacy"
      name="privacy"
      type="checkbox"
      required
      aria-describedby="error-privacy"
      class="mt-1 h-4 w-4 shrink-0 rounded border-river/40 bg-night/60 accent-[#1E7F6B]"
    />
    <div>
      <label for="privacy" class="text-xs leading-5 text-muted">
        He leído y acepto la <a href="/privacidad/" class="link-inline">política de privacidad</a>. Uso estos datos
        únicamente para responder a mi solicitud.
      </label>
      <p id="error-privacy" data-error-for="privacy" class="mt-2 hidden text-xs text-amber"></p>
    </div>
  </div>

  <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
    <label for="website">No rellenar este campo</label>
    <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button
    type="submit"
    data-submit
    class="group mt-7 inline-flex w-full items-center justify-center gap-2 rounded-full bg-amber px-6 py-3.5 text-sm font-medium text-night transition-colors hover:bg-[#f2b65b] disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
  >
    <span data-submit-label>Enviar mensaje</span>
    <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <p
    data-status
    class="mt-5 hidden rounded-xl border px-4 py-3 text-sm"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
  <p data-fallback class="mt-3 hidden text-xs leading-5 text-muted">
    También puedes escribir directamente a
    <a href={`mailto:${site.email}`} class="link-inline">{site.email}</a>.
  </p>

  <p class="mt-4 text-[0.7rem] leading-5 text-muted">
    Los campos con <span class="text-amber">*</span> son obligatorios. No compartimos tus datos con terceros
    ajenos a la prestación del servicio.
  </p>
</form>

<noscript>
  <p class="mt-3 text-sm text-muted">
    El formulario necesita JavaScript. Si prefieres, escribe a
    <a href={`mailto:${site.email}`} class="link-inline">{site.email}</a>.
  </p>
</noscript>

<script>
  import {
    contactFormReducer,
    initialContactFormState,
    isContactFormBusy,
    type ContactFormEvent,
    type ContactFormState,
  } from '../lib/contact-form-machine';

  const form = document.querySelector<HTMLFormElement>('[data-machine="contact-form"]');

  if (form) {
    const endpoint = form.dataset.endpoint?.trim();
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const submitLabel = form.querySelector<HTMLElement>('[data-submit-label]');
    const status = form.querySelector<HTMLElement>('[data-status]');
    const fallback = form.querySelector<HTMLElement>('[data-fallback]');

    const getField = <T extends HTMLElement>(name: string) =>
      form.elements.namedItem(name) as T | null;

    const fields = {
      name: getField<HTMLInputElement>('name'),
      email: getField<HTMLInputElement>('email'),
      company: getField<HTMLInputElement>('company'),
      message: getField<HTMLTextAreaElement>('message'),
      privacy: getField<HTMLInputElement>('privacy'),
      website: getField<HTMLInputElement>('website'),
    } as const;

    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
    const statusBaseClass = 'mt-5 hidden rounded-xl border px-4 py-3 text-sm';

    let state: ContactFormState = initialContactFormState;

    const renderState = () => {
      form.dataset.state = state;
      if (isContactFormBusy(state)) {
        form.setAttribute('aria-busy', 'true');
      } else {
        form.removeAttribute('aria-busy');
      }
      if (submit) submit.disabled = isContactFormBusy(state);
    };

    const dispatch = (event: ContactFormEvent) => {
      state = contactFormReducer(state, event);
      renderState();
    };

    const setError = (name: string, message: string) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLElement | null;
      if (error) {
        error.textContent = message;
        error.classList.remove('hidden');
      }
      input?.setAttribute('aria-invalid', 'true');
    };

    const clearError = (name: string) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      const input = form.elements.namedItem(name) as HTMLElement | null;
      if (error) {
        error.textContent = '';
        error.classList.add('hidden');
      }
      input?.removeAttribute('aria-invalid');
    };

    const clearAllErrors = () => {
      (['name', 'email', 'message', 'privacy'] as const).forEach(clearError);
    };

    const clearStatus = () => {
      if (!status) return;
      status.textContent = '';
      status.className = statusBaseClass;
      status.setAttribute('role', 'status');
      status.setAttribute('aria-live', 'polite');
      fallback?.classList.add('hidden');
    };

    const showStatus = (kind: 'success' | 'error', message: string) => {
      if (!status) return;
      status.textContent = message;
      status.className =
        kind === 'success'
          ? 'mt-5 rounded-xl border border-river/40 bg-river/10 px-4 py-3 text-sm text-ink'
          : 'mt-5 rounded-xl border border-amber/40 bg-amber/10 px-4 py-3 text-sm text-ink';
      status.setAttribute('role', kind === 'error' ? 'alert' : 'status');
      status.setAttribute('aria-live', kind === 'error' ? 'assertive' : 'polite');
      if (kind === 'error') fallback?.classList.remove('hidden');
    };

    const resetFields = () => {
      form.reset();
      clearAllErrors();
    };

    const validate = (): boolean => {
      clearAllErrors();
      let valid = true;
      let firstInvalid: HTMLElement | null = null;

      if (!fields.name || fields.name.value.trim().length < 2) {
        setError('name', 'Escribe tu nombre (al menos 2 caracteres).');
        valid = false;
        firstInvalid = firstInvalid ?? fields.name;
      }

      if (!fields.email || !emailPattern.test(fields.email.value.trim())) {
        setError('email', 'Escribe un correo válido, por ejemplo nombre@dominio.com.');
        valid = false;
        firstInvalid = firstInvalid ?? fields.email;
      }

      if (!fields.message || fields.message.value.trim().length < 20) {
        setError('message', 'Cuéntame un poco más: al menos 20 caracteres.');
        valid = false;
        firstInvalid = firstInvalid ?? fields.message;
      }

      if (!fields.privacy?.checked) {
        setError('privacy', 'Necesito tu aceptación para poder responderte.');
        valid = false;
        firstInvalid = firstInvalid ?? fields.privacy;
      }

      firstInvalid?.focus();
      return valid;
    };

    const handleFieldChange = (key: keyof typeof fields) => {
      clearError(key);
      if (state === 'invalid' && form.querySelectorAll('[aria-invalid="true"]').length === 0) {
        dispatch({ type: 'FIELD_FIXED' });
      }
    };

    (Object.keys(fields) as Array<keyof typeof fields>).forEach((key) => {
      if (key === 'website') return;
      fields[key]?.addEventListener('input', () => handleFieldChange(key));
      fields[key]?.addEventListener('change', () => handleFieldChange(key));
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (isContactFormBusy(state)) return;

      clearStatus();

      if (fields.website?.value) {
        resetFields();
        dispatch({ type: 'SPAM' });
        showStatus('success', 'Mensaje recibido.');
        return;
      }

      if (!validate()) {
        dispatch({ type: 'INVALID' });
        return;
      }

      if (!endpoint) {
        dispatch({ type: 'ENDPOINT_MISSING' });
        showStatus(
          'error',
          'El formulario no tiene un endpoint configurado. Escríbenos por correo mientras lo revisamos.',
        );
        return;
      }

      dispatch({ type: 'SEND' });
      const originalLabel = submitLabel?.textContent ?? 'Enviar mensaje';
      if (submitLabel) submitLabel.textContent = 'Enviando…';

      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            name: fields.name?.value.trim(),
            email: fields.email?.value.trim(),
            company: fields.company?.value.trim() || null,
            message: fields.message?.value.trim(),
            privacy: true,
            source: 'orinocoaisolutions.com/contacto',
            page: window.location.href,
            sentAt: new Date().toISOString(),
          }),
          signal: controller.signal,
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}`);
        }

        resetFields();
        dispatch({ type: 'SUCCESS' });
        showStatus(
          'success',
          'Mensaje recibido. Te escribiré al correo que indicaste para continuar la conversación.',
        );
      } catch {
        dispatch({ type: 'FAILURE' });
        showStatus(
          'error',
          'No pudimos enviar el mensaje. Revisa tu conexión o escríbenos directamente por correo.',
        );
      } finally {
        window.clearTimeout(timeout);
        if (submitLabel) submitLabel.textContent = originalLabel;
      }
    });

    renderState();
  }
</script>
