---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  ariaLabel?: string;
  showArrow?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className,
  ariaLabel,
  showArrow = true,
} = Astro.props;

const external = /^https?:\/\//.test(href);

const variants = {
  primary:
    'bg-amber text-night shadow-[0_10px_36px_-14px_rgba(232,163,61,0.7)] hover:bg-[#f2b65b]',
  secondary: 'border border-cyan/40 bg-transparent text-ink hover:border-cyan hover:bg-cyan/5',
  ghost: 'border border-transparent bg-transparent text-ink hover:text-cyan',
};

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3.5 text-base',
};
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2 rounded-full font-medium transition duration-200',
    variants[variant],
    sizes[size],
    className,
  ]}
  aria-label={ariaLabel}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span><slot /></span>
  {
    showArrow && (
      <svg
        class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
