---
import { cal } from '../lib/cal';

interface Props {
  autoLoad?: boolean;
}

const { autoLoad = true } = Astro.props;
---

<div
  id="cal-embed"
  class="card overflow-hidden"
  data-machine="cal-embed"
  data-state="facade"
  data-cal-embed
  data-cal-auto={autoLoad ? 'true' : 'false'}
  data-cal-link={cal.path}
  data-cal-origin={cal.origin}
  data-cal-script={cal.script}
>
  <div data-cal-facade class="flex min-h-[34rem] flex-col items-center justify-center px-6 py-12 text-center">
    <span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-river/35 bg-river/10 text-cyan">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="1.5" />
        <path d="M7.5 3v4M16.5 3v4M3.5 9.5h17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        <path d="M8 13h3M8 16.5h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </span>
    <h2 class="mt-6 font-display text-2xl font-semibold text-ink">Elige un horario directamente</h2>
    <p class="mt-3 max-w-sm text-sm leading-6 text-muted">
      {
        autoLoad
          ? 'El calendario se carga al acercarte a esta sección o cuando pulsas el botón. Si prefieres, también puedes abrirlo en una pestaña nueva.'
          : 'El calendario se carga cuando pulsas el botón. Si prefieres, también puedes abrirlo en una pestaña nueva.'
      }
    </p>
    <button
      type="button"
      data-cal-load
      class="mt-7 inline-flex items-center justify-center gap-2 rounded-full bg-amber px-5 py-3 text-sm font-medium text-night transition-colors hover:bg-[#f2b65b]"
    >
      Ver disponibilidad
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 8h9.5M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <a
      href={cal.href}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 text-xs text-muted underline decoration-river/50 underline-offset-4 transition-colors hover:text-cyan"
    >
      Abrir en {cal.host}
    </a>
    <p class="mt-5 max-w-xs text-[0.7rem] leading-5 text-muted">
      El calendario se sirve desde {cal.host}. Su uso se rige por la política de privacidad de ese servicio.
    </p>
  </div>

  <div data-cal-target class="hidden min-h-[38rem]">
    <div
      data-cal-loading
      class="flex min-h-[38rem] items-center justify-center gap-3 px-6 text-sm text-muted"
      role="status"
      aria-live="polite"
    >
      <span class="h-4 w-4 animate-spin rounded-full border-2 border-river/40 border-t-cyan" aria-hidden="true"></span>
      Cargando calendario…
    </div>
    <div
      data-cal-error
      class="hidden min-h-[20rem] flex-col items-center justify-center px-6 py-12 text-center"
      role="alert"
      aria-live="assertive"
    >
      <p data-cal-error-title class="font-display text-lg font-medium text-ink">No pudimos cargar el calendario.</p>
      <p data-cal-error-text class="mt-2 max-w-sm text-sm leading-6 text-muted">
        Puede ser un problema de red o del servicio de agenda. Abre el calendario directamente para reservar.
      </p>
      <a
        href={cal.href}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 rounded-full border border-cyan/40 px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-cyan hover:bg-cyan/5"
      >
        Abrir calendario
      </a>
    </div>
    <div id="cal-inline" class="min-h-[38rem] w-full"></div>
  </div>
</div>

<noscript>
  <p class="mt-3 text-sm text-muted">
    Activa JavaScript para ver el calendario aquí, o
    <a href={cal.href} class="link-inline" target="_blank" rel="noopener noreferrer">abre la agenda en una pestaña nueva</a>.
  </p>
</noscript>

<script>
  import {
    calEmbedReducer,
    initialCalEmbedState,
    isCalEmbedBusy,
    type CalEmbedEvent,
    type CalEmbedState,
  } from '../lib/cal-embed-machine';

  type CalFunction = ((...args: unknown[]) => void) & {
    q?: unknown[][];
    ns?: Record<string, CalFunction>;
    loaded?: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-machine="cal-embed"]');

  if (root) {
    const facade = root.querySelector<HTMLElement>('[data-cal-facade]');
    const target = root.querySelector<HTMLElement>('[data-cal-target]');
    const loading = root.querySelector<HTMLElement>('[data-cal-loading]');
    const error = root.querySelector<HTMLElement>('[data-cal-error]');
    const errorTitle = root.querySelector<HTMLElement>('[data-cal-error-title]');
    const errorText = root.querySelector<HTMLElement>('[data-cal-error-text]');
    const loadButton = root.querySelector<HTMLButtonElement>('[data-cal-load]');
    const scriptUrl = root.dataset.calScript;
    const origin = root.dataset.calOrigin;
    const calLink = root.dataset.calLink;
    const autoLoad = root.dataset.calAuto !== 'false';

    let state: CalEmbedState = initialCalEmbedState;
    const getState = () => state;

    const renderState = () => {
      root.dataset.state = state;

      if (isCalEmbedBusy(state)) {
        root.setAttribute('aria-busy', 'true');
      } else {
        root.removeAttribute('aria-busy');
      }

      const showFacade = state === 'facade';
      const showTarget = state !== 'facade';
      const showLoading = state === 'loading';
      const showError = state === 'error' || state === 'unavailable';

      facade?.classList.toggle('hidden', !showFacade);
      target?.classList.toggle('hidden', !showTarget);
      loading?.classList.toggle('hidden', !showLoading);
      error?.classList.toggle('hidden', !showError);
      error?.classList.toggle('flex', showError);

      if (state === 'unavailable') {
        if (errorTitle) errorTitle.textContent = 'El calendario no está disponible.';
        if (errorText) errorText.textContent = 'Abre la agenda directamente para reservar.';
      } else if (state === 'error') {
        if (errorTitle) errorTitle.textContent = 'No pudimos cargar el calendario.';
        if (errorText) {
          errorText.textContent =
            'Puede ser un problema de red o del servicio de agenda. Abre el calendario directamente para reservar.';
        }
      }
    };

    const dispatch = (event: CalEmbedEvent) => {
      state = calEmbedReducer(state, event);
      renderState();
    };

    const installCalQueue = (script: string) => {
      const w = window as unknown as { Cal?: CalFunction; document: Document };
      if (w.Cal) return w.Cal;

      const push = (queue: { q: unknown[][] }, args: unknown[]) => {
        queue.q.push(args);
      };

      const cal = function (...args: unknown[]) {
        const current = w.Cal as CalFunction & { q: unknown[][]; ns: Record<string, CalFunction> };
        if (!current.loaded) {
          current.ns = {};
          current.q = current.q || [];
          const element = w.document.createElement('script');
          element.src = script;
          element.async = true;
          w.document.head.appendChild(element);
          current.loaded = true;
        }

        if (args[0] === 'init') {
          const namespace = args[1];
          if (typeof namespace === 'string') {
            const api = function (...apiArgs: unknown[]) {
              push(api as unknown as { q: unknown[][] }, apiArgs);
            } as CalFunction;
            api.q = api.q || [];
            current.ns = current.ns || {};
            current.ns[namespace] = current.ns[namespace] || api;
            push(current.ns[namespace] as unknown as { q: unknown[][] }, args);
            push(current as unknown as { q: unknown[][] }, ['initNamespace', namespace]);
          } else {
            push(current as unknown as { q: unknown[][] }, args);
          }
          return;
        }

        push(current as unknown as { q: unknown[][] }, args);
      } as CalFunction;

      cal.q = [];
      cal.ns = {};
      cal.loaded = false;
      w.Cal = cal;
      return cal;
    };

    const load = () => {
      if (getState() !== 'facade') return;

      if (!scriptUrl || !origin || !calLink) {
        dispatch({ type: 'CONFIG_MISSING' });
        return;
      }

      dispatch({ type: 'LOAD' });

      try {
        const Cal = installCalQueue(scriptUrl);
        Cal('init', { origin });
        Cal('inline', {
          elementOrSelector: '#cal-inline',
          calLink,
          config: {
            theme: 'dark',
            layout: 'month_view',
          },
        });
      } catch {
        dispatch({ type: 'TIMEOUT' });
        return;
      }

      let timeoutId = 0;
      let intervalId = 0;
      let observer: MutationObserver | null = null;

      const cleanup = () => {
        window.clearTimeout(timeoutId);
        if (intervalId) window.clearInterval(intervalId);
        observer?.disconnect();
        observer = null;
      };

      const onReady = (frame: HTMLIFrameElement) => {
        if (getState() !== 'loading') return;
        cleanup();
        frame.setAttribute('title', 'Calendario para agendar una llamada');
        dispatch({ type: 'IFRAME_READY' });
      };

      const onTimeout = () => {
        if (getState() !== 'loading') return;
        cleanup();
        dispatch({ type: 'TIMEOUT' });
      };

      const check = () => {
        if (getState() !== 'loading') return;
        const frame = target?.querySelector('iframe');
        if (frame) onReady(frame);
      };

      timeoutId = window.setTimeout(onTimeout, 15000);
      check();

      if (getState() === 'loading' && target) {
        if (typeof MutationObserver !== 'undefined') {
          observer = new MutationObserver(check);
          observer.observe(target, { childList: true, subtree: true });
        } else {
          intervalId = window.setInterval(check, 500);
        }
      }
    };

    loadButton?.addEventListener('click', load);

    if (autoLoad && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            load();
          }
        },
        { rootMargin: '320px 0px' },
      );
      observer.observe(root);
    }

    renderState();
  }
</script>
