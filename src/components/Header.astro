---
import { cal } from '../lib/cal';
import { site } from '../data/site';
import Button from './Button.astro';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<header class="sticky top-0 z-50 border-b border-white/5 bg-night/85 backdrop-blur-xl">
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-6">
    <Wordmark />

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Navegación principal">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'relative py-1 text-sm transition-colors',
              isActive(item.href) ? 'text-ink' : 'text-muted hover:text-ink',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute inset-x-0 -bottom-1 mx-auto h-px w-5 bg-amber" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="hidden md:block">
        <Button href={cal.href} size="sm">Agenda una llamada</Button>
      </div>

      <details class="group relative lg:hidden" data-machine="mobile-menu" data-state="closed">
        <summary
          class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-full border border-white/10 text-ink transition-colors hover:border-cyan/50 hover:text-cyan [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only group-open:hidden">Abrir menú de navegación</span>
          <span class="sr-only hidden group-open:inline">Cerrar menú de navegación</span>
          <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </summary>

        <div class="absolute right-0 top-[calc(100%+0.65rem)] w-[calc(100vw-2.5rem)] max-w-xs rounded-2xl border border-river/25 bg-night/98 p-3 shadow-2xl backdrop-blur-xl">
          <nav class="flex flex-col" aria-label="Navegación móvil">
            {
              site.nav.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'rounded-xl px-4 py-3 text-base transition-colors',
                    isActive(item.href) ? 'bg-river/15 text-ink' : 'text-muted hover:bg-white/5 hover:text-ink',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <Button href={cal.href} size="md" class="mt-3 w-full">Agenda una llamada</Button>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-machine="mobile-menu"]');

  if (menu) {
    const summary = menu.querySelector<HTMLElement>('summary');

    const syncState = () => {
      menu.dataset.state = menu.open ? 'open' : 'closed';
    };

    syncState();
    menu.addEventListener('toggle', syncState);

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (!menu.open) return;
      const target = event.target as Node | null;
      if (target && !menu.contains(target)) menu.open = false;
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.open = false;
      });
    });

    const desktop = window.matchMedia('(min-width: 1024px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>
