---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<!-- Native <details> is intentional: no JS, and multiple answers may stay open so readers can compare. -->
<div data-machine="faq" class="divide-y divide-river/20 border-y border-river/20">
  {
    items.map((item, index) => (
      <details class="group" open={index === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left [&::-webkit-details-marker]:hidden">
          <span class="font-display text-base font-medium text-ink transition-colors group-hover:text-cyan md:text-lg">
            {item.question}
          </span>
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-river/40 text-cyan transition-transform duration-200 group-open:rotate-45" aria-hidden="true">
            <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none">
              <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <p class="max-w-3xl pb-6 pr-10 text-sm leading-7 text-muted">{item.answer}</p>
      </details>
    ))
  }
</div>
